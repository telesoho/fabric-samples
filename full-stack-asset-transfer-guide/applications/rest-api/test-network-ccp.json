{
  "name": "test-network",
  "description": "The network to be in if you like scenario tests, not vegetables",
  "version": "2.5",
  "client": {
    "organization": "Org1",
    "credentialStore": {
      "wallet": "./wallet-data"
    }
  },
  "channels": {
    "mychannel": {
      "orderers": [],
      "peers": [],
      "chaincodes": []
    }
  },
  "organizations": {
    "Org1": {
      "mspid": "Org1MSP",
      "peers": ["peer1.org1"],
      "certificateAuthorities": ["org1-ca"]
    }
  },
  "peers": {
    "peer1.org1": {
      "address": "test-network-org1-peer1-peer.localho.st:443",
      "tlsCACerts": {
        "path": "./wallet-data/tlsca-signcert.pem"
      },
      "clientOptions": {
        "grpc.ssl_target_name_override": "test-network-org1-peer1-peer.localho.st"
      }
    }
  },
  "certificateAuthorities": {
    "org1-ca": {
      "url": "https://test-network-org1-ca-ca.localho.st:443",
      "caName": "ca",
      "tlsCACerts": {
        "path": "./wallet-data/tlsca-signcert.pem"
      },
      "httpOptions": {
        "verify": false,
        "request-timeout": 30000
      },
      "registrar": [
        {
          "enrollId": "rcaadmin",
          "enrollSecret": "rcaadminpw"
        }
      ]
    }
  }
}
